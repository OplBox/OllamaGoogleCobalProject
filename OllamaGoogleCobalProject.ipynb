 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Ollama Public API with ngrok in Google Colab\n",
    "\n",
    "This notebook sets up Ollama, exposes it to the public internet using ngrok, and provides a Python function to interact with the public API."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Install Ollama\n",
    "!echo \"Installing Ollama...\"\n",
    "!curl -fsSL https://ollama.com/install.sh | sh"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Install pyngrok\n",
    "!pip install pyngrok"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Add your ngrok authtoken\n",
    "# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken\n",
    "from getpass import getpass\n",
    "\n",
    "NGROK_AUTHTOKEN = getpass(\"Enter your ngrok authtoken: \")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Start the Ollama server in the background\n",
    "!echo \"Starting Ollama server...\"\n",
    "!nohup ollama serve &\n",
    "import time\n",
    "time.sleep(5)\n",
    "!echo \"Ollama server should be running.\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Pull a fast code generation model\n",
    "!echo \"Pulling the codegemma:2b model...\"\n",
    "!ollama pull codegemma:2b"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. Start the ngrok tunnel and get the public URL\n",
    "from pyngrok import ngrok\n",
    "\n",
    "ngrok.set_auth_token(NGROK_AUTHTOKEN)\n",
    "public_url = ngrok.connect(11434)\n",
    "print(f\"Ollama API is live at: {public_url}\")\n",
    "\n",
    "# This URL is what you will use in your other service to access the API."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Interact with the Public API\n",
    "\n",
    "Use the public URL from the cell above to send requests from any external service. The function below is an example of how to structure the request."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "import json\n",
    "\n",
    "def generate_code_from_public_api(prompt, api_url, model=\"codegemma:2b\"):\n",
    "    \"\"\"\n",
    "    Sends a prompt to the public Ollama API and returns the generated code.\n",
    "    \"\"\"\n",
    "    # The endpoint for generation is /api/generate\n",
    "    full_url = f\"{api_url}/api/generate\"\n",
    "    \n",
    "    payload = {\n",
    "        \"model\": model,\n",
    "        \"prompt\": prompt,\n",
    "        \"stream\": False\n",
    "    }\n",
    "    \n",
    "    try:\n",
    "        response = requests.post(full_url, json=payload)\n",
    "        response.raise_for_status()\n",
    "        response_data = response.json()\n",
    "        return response_data.get(\"response\", \"No response content found.\")\n",
    "    \n",
    "    except requests.exceptions.RequestException as e:\n",
    "        return f\"Error connecting to the public API: {e}\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 8. Example: Generate a Python function using the public URL\n",
    "# Make sure to replace 'public_url' with the actual URL printed in step 6.\n",
    "\n",
    "if 'public_url' in locals():\n",
    "    code_prompt = \"Write a short Python function to reverse a string.\"\n",
    "    print(f\"Prompt: {code_prompt}\")\n",
    "    print(\"-"*20 + \"\nGenerated Code:\")\n",
    "    \n",
    "    # We pass the ngrok tunnel object which has the public URL attribute\n",
    "    generated_code = generate_code_from_public_api(code_prompt, public_url.public_url)\n",
    "    print(generated_code)\n",
    "else:\n",
    "    print(\"Please run step 6 first to get the public URL.\")"
   ]
  }
